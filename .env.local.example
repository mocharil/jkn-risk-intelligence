# ---------------------------------------------------------------------------
# Arsa AI - JKN Risk Intelligence  (salin ke .env.local)
# ---------------------------------------------------------------------------

# --- Keamanan (WAJIB diganti di produksi) ---
AUTH_SECRET=ganti-dengan-string-acak-panjang
PII_HMAC_SECRET=ganti-dengan-string-acak-panjang-untuk-pseudonim
# Kata sandi akun demo (investigator@arsa.id, supervisor@arsa.id, admin@arsa.id). Default: Arsa#2026
# DEMO_PASSWORD=
# Kunci mode produksi ketat (wajibkan secret, matikan /api/demo/* & registrasi mandiri). Biarkan kosong untuk mode demo lokal:
# ARSA_STRICT_PRODUCTION=1
# ALLOW_SELF_REGISTER=0
# ARSA_DISABLE_DEMO=1

# --- LLM (pilih SATU provider; kosongkan LLM_PROVIDER untuk otomatis: gemini -> openai -> anthropic) ---
# LLM_PROVIDER=gemini | openai | anthropic     (alias: openai-compatible, azure, ollama, vllm, openrouter, claude)
# LLM_MODEL=                                   (opsional, menimpa model bawaan provider)

# [gemini] Vertex AI via service account: letakkan file di ./gemini_sa.json (sudah di-.gitignore)
#          atau isi VERTEX_SA_JSON (JSON mentah / base64) saat deployment. Atau pakai API key AI Studio:
# VERTEX_SA_JSON=
# VERTEX_SA_PATH=
# VERTEX_LOCATION=us-central1
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=text-embedding-004
# Kredensial ambient mesin (GOOGLE_APPLICATION_CREDENTIALS) TIDAK dipakai kecuali Anda opt-in:
# ARSA_ALLOW_AMBIENT_CREDENTIALS=1

# [openai] OpenAI / Azure / OpenRouter / vLLM / LM Studio / Ollama (/v1) — semua yang kompatibel OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1      (kosongkan untuk api.openai.com)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  (kosongkan bila server tidak punya embedding -> embedding lokal)
# OPENAI_JSON_MODE=0                             (set 0 bila server tidak mendukung response_format)

# [anthropic] Claude (tanpa embedding -> embedding lokal)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Database Postgres + pgvector (OPSIONAL; mis. Supabase atau `npm run db:up`) ---
# DATABASE_URL=postgres://postgres:arsa@localhost:54329/arsa
# VECTOR_BACKEND=pgvector        # pencarian kemiripan di database (indeks HNSW)
# AUDIT_DB_MIRROR=1              # cermin audit trail ke tabel append-only ber-trigger (default aktif bila DATABASE_URL ada)

# --- Autentikasi ---
# AUTH_PROVIDER=supabase         # pakai Supabase Auth (peran dari app_metadata.role); default: akun lokal

# --- Batas laju (permintaan/menit/IP) ---
# RATE_LIMIT_API=600
# RATE_LIMIT_AI=30
# RATE_LIMIT_UPLOAD=12
# RATE_LIMIT_AUTH=20

# --- Ambang klon (opsional; default aman) ---
# CLONE_SIM_THRESHOLD=0.88
# CLONE_LEXICAL_THRESHOLD=0.75

# --- Supabase (OPSIONAL: hanya untuk mirror data; aplikasi berjalan tanpa ini) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
